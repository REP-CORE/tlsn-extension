# syntax=docker/dockerfile:1
# TEE notary image for a Phala dstack TDX CVM.
# Build context: the tlsn-extension `servers/` Cargo workspace root, with this kit at deploy-tee/.
# Built via Fly's remote builder (no local docker) with a REP-CORE git token as a build-secret:
#   fly deploy --build-only --push -a rep-notary-tee --build-secret ghtoken=<token>

# Base images by floating tag (matching the known-good image that boots on dstack).
# HISTORY 2026-09-29: pinning these by sha256 digest (rust@sha256:93ce27a8…, debian-slim@sha256:3783cc01…)
# produced an image that FAILED to start a container on dstack (live upgrade AND a staging CVM both went
# status=error with "No containers found"; the image manifest was a normal single OCI manifest identical
# in shape to the working image, so it was NOT a pull/format problem — an immediate startup crash, most
# likely the newer digest-pinned debian-slim changing openssl/keygen behavior at boot). Reverted to
# floating tags to isolate and get a booting image from committed source. Reproducible base pinning is a
# follow-up: pin to the SAME digest the known-good image used, or a platform-specific digest, and only
# after confirming it boots on a staging CVM. See README-REPRO.md / TRUST-MODEL.md.
FROM rust:bookworm AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev clang cmake protobuf-compiler git && rm -rf /var/lib/apt/lists/*
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
COPY Cargo.toml Cargo.lock ./
COPY verifier/Cargo.toml ./verifier/
COPY swissbank/Cargo.toml ./swissbank/
RUN mkdir -p verifier/src swissbank/src && \
    echo "fn main() {}" > verifier/src/main.rs && \
    echo "fn main() {}" > swissbank/src/main.rs
# private REP-CORE/tlsn dep: authenticate git with the build-secret, fetch, then drop the credential.
RUN --mount=type=secret,id=ghtoken \
    git config --global credential.helper store && \
    printf "https://x-access-token:%s@github.com\n" "$(cat /run/secrets/ghtoken)" > /root/.git-credentials && \
    (cargo fetch --locked || cargo fetch) && \
    rm -f /root/.git-credentials
COPY verifier/src ./verifier/src
RUN touch verifier/src/main.rs
RUN --mount=type=secret,id=ghtoken \
    git config --global credential.helper store && \
    printf "https://x-access-token:%s@github.com\n" "$(cat /run/secrets/ghtoken)" > /root/.git-credentials && \
    cargo build --release --bin tlsn-verifier-server && \
    rm -f /root/.git-credentials

FROM debian:bookworm-slim
WORKDIR /app
# GIT_HASH must be the commit SHA of the committed notary snapshot this image is built from, passed
# by build-notary-tee.sh (--build-arg GIT_HASH=<sha>). The old default "tee" meant the running image
# recorded no source commit; keep the placeholder only as a loud fallback so an unpinned build is
# obvious in the running binary's /health or logs.
ARG GIT_HASH=UNPINNED-dirty-build
ENV GIT_HASH=${GIT_HASH}
# openssl for in-enclave keygen, python3 for the attestation sidecar, curl for health.
RUN apt-get update && apt-get install -y ca-certificates libssl3 openssl python3 xxd curl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/tlsn-verifier-server /app/tlsn-verifier-server
COPY verifier/config-prod.yaml /app/config.yaml
# the deploy kit (adjust source paths to where you placed the kit in the build context)
COPY deploy-tee/keygen.sh /app/keygen.sh
COPY deploy-tee/entrypoint.sh /app/entrypoint.sh
COPY deploy-tee/attestation_server.py /app/attestation_server.py
RUN chmod +x /app/keygen.sh /app/entrypoint.sh

# 7047 notary/verify, 7048 attestation sidecar.
EXPOSE 7047 7048
# NO NOTARY_SIGNING_KEY here: the key is born inside the enclave at boot (entrypoint).
ENTRYPOINT ["/app/entrypoint.sh"]
